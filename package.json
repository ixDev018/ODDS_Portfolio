{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve": "php artisan serve",
        "queue": "php artisan queue:listen --tries=1 --timeout=0",
        "dev:all": "concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"npm run serve\" \"npm run queue\" \"npm run dev\" --names=\"server,queue,vite\" --kill-others"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "gsap": "^3.15.0"
    }
}
